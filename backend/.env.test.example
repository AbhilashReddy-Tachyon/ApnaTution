# Copy to `.env.test`. Never commit the filled-in file.
#
# This file is read ONLY when NODE_ENV=test, and when it is read, `.env` is not
# loaded at all. That is deliberate: the production connection string never
# enters a test process, so no bug can aim a test run at real data.
#
# Because `.env` is skipped, anything the tests need must be repeated here.

# ── Required ─────────────────────────────────────────────────────────────────

# Your TEST cluster — a different Atlas project/cluster from production, with
# its own database user. The database name must read as a test database
# ("apnatutors_test", "test", "test-apnatutors"); src/config/mongoTarget.cjs
# refuses to connect otherwise, and refuses if the host matches MONGO_URI.
#
# Name the database explicitly. With no name, the driver quietly uses one
# called "test", which is easy to mistake for an empty prod database.
MONGO_URI_TEST=mongodb+srv://user:pass@test-cluster.xxxxx.mongodb.net/apnatutors_test?retryWrites=true&w=majority

# Signs auth tokens during tests. Any throwaway value of 8+ characters; there
# is no reason for this to match production.
JWT_SECRET=test-only-secret-not-used-anywhere-else

# ── Runtime ──────────────────────────────────────────────────────────────────

# Keep this. Integration tests that boot the app should be run with
# `node --env-file=.env.test ...` so NODE_ENV is set before any module loads;
# this line is what makes that work. (`npm run db:check:test` and the unit
# tests set it themselves and do not need the flag.)
NODE_ENV=test

# Quieter test output. Raise to debug when diagnosing a failure.
LOG_LEVEL=warn

# A port that won't collide with a running dev server on 5000.
PORT=5050

# ── Optional ─────────────────────────────────────────────────────────────────
# Leave these blank to keep tests hermetic: the matching features disable
# themselves and the routes return a scoped 503 rather than calling a real
# third party. Fill one in only for a test that genuinely needs it.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_USER=
EMAIL_PASSWORD=

CRON_SECRET=

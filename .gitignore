# Core node_modules
node_modules/
**/node_modules/

# Environment variables.
# The `.env.*` patterns matter: `.env` alone does NOT cover `.env.test`,
# `.env.local` etc., so without them a filled-in test config would be
# committed. The *.example templates are deliberately re-included.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Angular specific (if any at root or subfolders)
.angular/
/apna-tution-frontend/dist/
/apna-tution-frontend/.angular/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs
*.log

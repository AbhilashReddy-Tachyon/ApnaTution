# Copy to `.env` and fill in real values. Never commit the filled-in file.
# `src/config/env.cjs` validates these at boot: missing REQUIRED vars abort a
# production start, and missing optional vars disable the feature that needs
# them (the reason is logged as a warning at startup).

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string for this environment (dev or production),
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/apnatutors
#
# The database name must NOT read as a test database when NODE_ENV=production —
# src/config/mongoTarget.cjs refuses to start rather than serve test data.
MONGO_URI=

# Signs auth tokens. Must be at least 32 characters in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Tests ────────────────────────────────────────────────────────────────────
# Tests do NOT read this file. They read `.env.test` (see .env.test.example),
# which keeps the production connection string out of a test process entirely.
# Nothing to set here.

# ── Runtime ──────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Defaults to debug locally, info in production.
LOG_LEVEL=

# How long an access token stays valid. Keep this short for a payments app.
JWT_EXPIRES_IN=7d

# Extra allowed CORS origin beyond the built-in list, e.g. https://apnatutors.com
FRONTEND_URL=

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
# Without these, payment routes are disabled.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required in production whenever Razorpay is enabled: without it, webhook
# signatures cannot be verified and anyone can credit points to any account.
RAZORPAY_WEBHOOK_SECRET=

# ── Email (password reset, verification) ─────────────────────────────────────
# Without EMAIL_USER and EMAIL_PASSWORD, password reset and OTP email are disabled.

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
FROM_NAME=ApnaTutors
FROM_EMAIL=

# ── Scheduled jobs ───────────────────────────────────────────────────────────

# Bearer secret for GET /admin/cron/expire-leads. The route fails closed when
# this is unset, so the endpoint is never publicly callable.
CRON_SECRET=
